# Grafana is remotely reachable by default. The remaining interfaces bind only
# to localhost because Prometheus, Loki, Alloy and cAdvisor do not have auth in
# this local single-host setup.
GRAFANA_BIND_ADDRESS=0.0.0.0
MONITORING_BIND_ADDRESS=127.0.0.1

# All published host ports are 5000+.
GRAFANA_PORT=5000
PROMETHEUS_PORT=5001
ALLOY_PORT=5002
CADVISOR_PORT=5003
LOKI_PORT=5004

# Grafana login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=xxx

# Label attached to Docker logs. Use a stable server name.
MONITORING_HOST=UBUNTU-PROD

# Data retention.
PROMETHEUS_RETENTION=30d

TZ=Europe/Bratislava
