# Grafana is remotely reachable by default. The remaining interfaces bind only
# to localhost because Prometheus, Loki, Alloy and cAdvisor do not have auth in
# this local single-host setup.
GRAFANA_BIND_ADDRESS=0.0.0.0
MONITORING_BIND_ADDRESS=127.0.0.1

# All published host ports are 5000+.
GRAFANA_PORT=5000
PROMETHEUS_PORT=5001
ALLOY_PORT=5002
CADVISOR_PORT=5003
LOKI_PORT=5004
SEAWEEDFS_S3_PORT=5005

# Grafana login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=xxx

# Label attached to Docker logs. Use a stable server name.
MONITORING_HOST=UBUNTU-PROD

# k3s collection (optional) is configured in Kubernetes, not here — see
# k8s/15-alloy-endpoints.yaml and README section 11. If LOKI_PORT or
# PROMETHEUS_PORT above are changed, update that file to match: the in-cluster
# Alloy ships to those ports on the server's loopback.

# Data retention. Both set to ~13 months (395d). Loki's value is additionally
# enforced as a WORM lock on the SeaweedFS bucket (see below) — Prometheus
# metrics are retained the same length but NOT write-protected; see README
# section 10a for why.
PROMETHEUS_RETENTION=395d

# SeaweedFS: self-hosted S3-compatible object store backing Loki, with
# Object Lock (WORM) and encryption at rest. See README section 10a.
# SEAWEEDFS_ACCESS_KEY / SEAWEEDFS_SECRET_KEY: picked by you, used only for
# request signing — this stack runs SeaweedFS's S3 gateway without its own
# IAM/identity store (consistent with the rest of this stack: no app-level
# auth, protected by network binding only). Any value works; keep it secret
# anyway since it may become real access control later.
SEAWEEDFS_ACCESS_KEY=xxx
SEAWEEDFS_SECRET_KEY=xxx
# Generate with: openssl rand -hex 32
SEAWEEDFS_SSE_KEK=xxx
SEAWEEDFS_LOKI_BUCKET=loki-logs
# GOVERNANCE: on paper, a break-glass override (--bypass-governance-retention)
# can still delete early. COMPLIANCE: nobody can, not even root, until the
# 395 days are up — including for a GDPR erasure request.
# TESTED 2026-11-23 against chrislusf/seaweedfs:4.54: the bypass flag is
# ignored (delete still returns AccessDenied), so GOVERNANCE currently
# behaves exactly like COMPLIANCE here — no working early-delete path.
# Kept as GOVERNANCE anyway (harmless, picks up the bypass for free if a
# future SeaweedFS version honors it) — just don't rely on being able to
# override early on this version. See README section 11.2.
SEAWEEDFS_RETENTION_MODE=GOVERNANCE

# Syslog receivers (firewall + ESET PROTECT On-Prem) must be reachable FROM
# those devices on the LAN — do not leave this at 127.0.0.1 if they're on a
# different host. Restrict with a host firewall rule to just those two IPs,
# since syslog has no auth of its own.
SYSLOG_BIND_ADDRESS=127.0.0.1
SYSLOG_FIREWALL_PORT=5007
SYSLOG_ESET_PORT=5008

# Microsoft Entra ID sign-in/audit log exporter. Needs an Azure App
# Registration with Application permissions AuditLog.Read.All +
# Directory.Read.All, admin-consented — create this manually in the Azure
# portal, see exporters/entra-signin-logs/README.md.
ENTRA_TENANT_ID=xxx
ENTRA_CLIENT_ID=xxx
ENTRA_CLIENT_SECRET=xxx
ENTRA_POLL_INTERVAL_SECONDS=300

TZ=Europe/Bratislava
